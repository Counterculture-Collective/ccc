---
layout: base.njk
title: Counterculture Collective
description: Counterculture Collective is a free community event which seeks to foster creativity and social connection through sonic experience...
---

<div class="homepage-hero">
  <h1>COUNTERCULTURE<br>
    <span>COLLECTIVE</span></h1>
  <p class="tagline">
    <span>LIBERATION</span>
    <span>THROUGH</span>
    <span>VIBRATION</span>
  </p>
  <nav class="hero-nav">
    <a class="btn btn--large" href="#about">ABOUT</a>
  </nav>
</div>

<section id="shows" class="shows-section">

  <div class="shows-image">
    <img src="/images/tables-and-waves.jpg" alt="">
  </div>

  <div class="shows">
    <header class="shows__header">
      {% include "icon-calendar.njk" %}
      <h2>2026<br>SCHEDULE</h2>
    </header>

    {# shows | limit(n) returns the first n entries in shows.json order, 
    upcoming or not. Use `upcoming(n)` for future shows only. #}

    <ul class="shows__list">
      {% for show in shows | limit(3) %}
        <li>
          <h3>{{ show.date | showDate | safe }}</h3>
          <p>@{{ show.venue }}</p>
          <p>{{ show.address | safe }}</p>
          <p class="times">
            <strong>Sign up at {{ show.signup }}, Music begins at {{ show.start }}</strong>
          </p>
        </li>
      {% endfor %}
    </ul>

    <button class="btn btn--small shows__btn">MORE FUTURE EVENTS</button>
  </div>
</section>

<section id="about" class="about-section">
  <div class="about-section__content">
    {{ content | safe }}
  </div>
</section>